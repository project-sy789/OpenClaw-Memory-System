# OpenAI API Key (required for embeddings)
OPENAI_API_KEY=sk-your-key-here

# Memory storage directory (default: ./memory)
MEMORY_DIR=./memory

# Token budget for retrieval (default: 4000)
TOKEN_BUDGET=4000

# Embedding model (default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimensions (default: 1536, can reduce to 512 for storage savings)
EMBEDDING_DIMENSIONS=1536

# Memory decay retention rate (0-1, default: 0.95)
DECAY_RETENTION_RATE=0.95

# Consolidation interval in hours (default: 24)
CONSOLIDATION_INTERVAL=24

# Log level (debug|info|warn|error)
LOG_LEVEL=info
