# ============================================================
# OpenClaw Memory System - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# 
# Quick setup:
#   cp .env.example .env
#   nano .env
# ============================================================

# ----------------------------------------------------------
# AI PROVIDERS - Choose one (or use mock for testing)
# ----------------------------------------------------------

# Option 1: Minimax (recommended - cheap & good for Thai)
# Get API key: https://platform.minimaxi.chat/
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
EMBEDDING_MODEL=embo-01
EMBEDDING_DIMENSIONS=1024

# Option 2: OpenAI
# Get API key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ----------------------------------------------------------
# MEMORY SETTINGS
# ----------------------------------------------------------

# Directory for SQLite database
MEMORY_DIR=./memory

# Max tokens for retrieval (default: 4000)
TOKEN_BUDGET=4000

# Memory decay rate (0-1, higher = keep longer)
DECAY_RETENTION_RATE=0.95

# Consolidation interval (hours)
CONSOLIDATION_INTERVAL=24

# ----------------------------------------------------------
# LOGGING
# ----------------------------------------------------------

# Log level: debug | info | warn | error
LOG_LEVEL=info
